# ---------------------------------------------------------------------------
# SWARA AI - copy this file to ".env" (same folder) and fill in your key.
# NEVER commit .env. The key is only read by the backend; the browser never sees it.
# ---------------------------------------------------------------------------

# Gnani AI (https://docs.gnani.ai) - generate a key on the Gnani API platform: https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai

# Speech-to-text: prisma-v2.5 (default) or prisma-v3.0
GNANI_STT_MODEL=prisma-v2.5
# verbatim | transcribe (ITN, hi-IN / en-IN only on v2.5)
GNANI_STT_FORMAT=verbatim
# Send inventory names as bias_list (v2.5 only, experimental - measure before relying on it)
GNANI_STT_BIAS=false

# Text-to-speech
GNANI_TTS_MODEL=timbre-v2.5
# One voice per language, from the Timbre v2.5 catalogue documented by Gnani (docs/LANGUAGES.md lists them). A name that is not in that
# list for the language is ignored and the default below is used.
TTS_VOICE_GU=Falak
TTS_VOICE_HI=Nalini
TTS_VOICE_EN=Devika
TTS_VOICE_HINGLISH=Poorvi
TTS_VOICE_MR=Zahira
TTS_VOICE_BN=Kirra
TTS_VOICE_TA=Asmita
TTS_VOICE_TE=Lavanya
TTS_VOICE_KN=Saanvi
TTS_VOICE_ML=Reshma
TTS_VOICE_PA=Mehuli

# Languages to switch off (not offered for voice, refused by the API), as a comma list of keys: gu hi en hinglish mr bn ta te kn ml pa.
# English cannot be switched off. The owner can also do this in Settings, which writes this line.
DISABLED_LANGUAGES=

# The shop's name: shown in the sidebar and at the top of printed bills. The owner can change it in Settings, which writes this
# line for you. If you type it by hand: 2 to 80 characters, letters, numbers, spaces and & ' . , - ( ) / + @ only (no # " $ or line
# breaks). Leave it commented out to keep the built-in demo name.
# STORE_NAME="Patel Kirana & General Store (demo)"

# Local safety valve so a bug or loop cannot burn the free credits (calls per hour)
GNANI_MAX_CALLS_PER_HOUR=300

# How long to wait for Gnani, per call (added in 2.6.0). Leave these out to use the defaults shown. A call that was sent and then gets no answer in time
# stops with a clear "took too long, try again" message and is NOT repeated; a failure to connect is still retried up to 3 times.
# GNANI_STT_TIMEOUT_S=20
# GNANI_TTS_TIMEOUT_S=15
# GNANI_CONNECT_TIMEOUT_S=5
# GNANI_TIMEOUT_S=40   # the older single setting: now a ceiling that the three above may not exceed

# Optional. Evon v3.3 is NOT exposed on Gnani's public API. Leave empty unless you
# host an OpenAI-compatible Evon endpoint yourself. See docs/EVON.md.
EVON_BASE_URL=
EVON_API_KEY=

# ---------------------------------------------------------------------------
# Accounts and sign-in (full guide: docs/AUTHENTICATION.md)
# Every page except the landing page, the legal pages and the sign-in screens needs a signed-in person.
# The old shared ADMIN_TOKEN no longer exists; owner and staff accounts replace it.
# ---------------------------------------------------------------------------

# Who becomes the owner (can change settings, see the team and the contact inbox).
#   Empty  = the FIRST account created becomes the owner. Fine on your own computer. On a server that is reachable from the
#            internet, create the owner yourself right after the first start, or set the line below, or whoever opens the
#            sign-up page first becomes the owner.
#   Set    = only an account created with exactly this e-mail address becomes the owner; everyone else is staff.
OWNER_EMAIL=

# True: anyone can create a staff account from the sign-up page.
# False: the sign-up form is closed. The owner adds people with: backend\.venv\Scripts\python.exe scripts\auth_admin.py create-staff --email ... --name ...
ALLOW_SIGNUP=true

# The "try it" box on the landing page calls POST /api/text/parse without a sign-in. It answers with item names, prices and stock from
# THIS shop's database. That is right for a demo, and wrong for a real shop that does not want strangers browsing its price list.
# false: that endpoint then needs a signed-in person, and the landing page says the demo is switched off.
PUBLIC_DEMO=true

# The address people type to reach the app. Used in the links inside e-mails and to decide whether the session cookie is
# "Secure" (https) or plain (http). Set it to your real https address when you deploy. It is never taken from a request header.
PUBLIC_URL=http://localhost:8000
# Leave empty to follow PUBLIC_URL (https => Secure cookie). Set true or false only if a proxy makes that guess wrong.
# COOKIE_SECURE=

# Sign-in lifetimes. A normal session ends after SESSION_HOURS, or after SESSION_IDLE_MINUTES without use.
# "Keep me signed in" uses REMEMBER_DAYS and REMEMBER_IDLE_DAYS.
# SESSION_HOURS=12
# SESSION_IDLE_MINUTES=120
# REMEMBER_DAYS=30
# REMEMBER_IDLE_DAYS=7

# Brute-force protection (kept in memory of ONE server process; see docs/DEPLOYMENT.md for what that means).
# AUTH_RATE_PER_MINUTE=20
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15

# --- E-mail (needed for: password reset links, e-mail verification, contact-form notifications) -----------------------
# Without SMTP nothing is ever "sent". The app says so on screen, and:
#   - the forgot-password page tells the person that e-mail is not set up and the owner can set a new password with
#     scripts/auth_admin.py reset-password,
#   - e-mail verification is NOT required (it cannot be),
#   - contact-form messages are only saved, and the owner reads them in Account > Messages.
# Use the SMTP details of any provider you already have (your domain's mail host, Brevo, Mailgun, Amazon SES, Gmail with an
# app password, ...). Nothing here is tested against a live provider by this project, so after filling it in run:
#     backend\.venv\Scripts\python.exe scripts\auth_admin.py test-mail --to you@yourdomain.com
# SMTP counts as set up only when BOTH SMTP_HOST and SMTP_FROM are filled in. See docs/AUTHENTICATION.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender shown to the person, e.g.  SWARA AI <no-reply@yourdomain.com>  (use an address your provider lets you send from)
SMTP_FROM=
# starttls (port 587, most common) | ssl (port 465) | none (only for a local test mail catcher)
SMTP_SECURITY=starttls
# Also e-mail each contact-form message to this address. Optional; the message is saved either way.
CONTACT_TO=
# Empty = verification is required only when SMTP is set up. true / false forces it.
# REQUIRE_EMAIL_VERIFICATION=

# Database (SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/db)
# DATABASE_URL=sqlite:///./backend/data/swara.db   (a database file from before the product was renamed is still found and used automatically)

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The API reference page at /docs (and the schema at /openapi.json). It lists every route and holds no data or keys.
# Set false on a public server if you do not want the list of routes shown.
# API_DOCS=true

# How many days of GENERATED (synthetic, labelled "Demo") orders to create when the database is first seeded: 7 to 366.
# The default is long enough for the weekly and monthly charts and for period-on-period comparisons.
# Changing it later needs `backend\.venv\Scripts\python.exe scripts\seed_db.py --reset`, which deletes local data.
# DEMO_HISTORY_DAYS=120

# ---------------------------------------------------------------------------
# Payments (added in 2.7.0). Full guide: docs/RAZORPAY_SETUP.md. Cash and manual UPI work without any of this.
# Razorpay is OFF until the key id and key secret below are filled in, and it starts in TEST mode. Nothing here switches live payments on.
#
# Secrets stay in this file on the server. The key SECRET and the WEBHOOK secret are never sent to the browser, never shown on any screen and never
# written to the logs. Never paste them into a chat, an e-mail, a screenshot or a support ticket. Never commit .env.
# ---------------------------------------------------------------------------

# test = Razorpay test keys (rzp_test_...), no real money moves. live = real money; needs live keys (rzp_live_...) AND this set to live on purpose.
PAYMENT_MODE=test
# Razorpay Dashboard > Account & Settings > API keys. The key id is public (the browser needs it to open Checkout); the key secret is not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks > the secret you type there. It is a different value from the key secret. Without it the webhook endpoint refuses every call.
RAZORPAY_WEBHOOK_SECRET=

# Optional. Razorpay's own dynamic UPI QR (Razorpay must switch it on for your account first; see docs/RAZORPAY_SETUP.md). Leave off to use the shop's own UPI ID.
# RAZORPAY_UPI_QR=false
# Optional. The shop's own UPI ID for the manual UPI QR (the owner can also set these in Settings, which writes them here). A manual UPI payment stays
# marked as not verified until a person confirms it. It is not a secret.
# UPI_VPA=
# UPI_PAYEE_NAME=
# A payment still waiting after this many minutes is shown as stale (it is never closed on its own).
# PAYMENT_PENDING_MINUTES=30
